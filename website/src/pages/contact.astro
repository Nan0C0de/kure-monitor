---
import '../styles/custom.css';
import '../tailwind.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact Us | Kure Monitor</title>
    <meta name="description" content="Get in touch with the Kure Monitor team. Reach out for technical support, enterprise deployments, bug reports, feature requests, or general inquiries." />
    <link rel="canonical" href="https://kuremonitor.com/contact/" />

    <!-- OpenGraph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kuremonitor.com/contact/" />
    <meta property="og:title" content="Contact Us | Kure Monitor" />
    <meta property="og:description" content="Get in touch with the Kure Monitor team for support, feature requests, enterprise deployment questions, or security inquiries." />
    <meta property="og:image" content="https://kuremonitor.com/images/og-image.png" />
    <meta property="og:site_name" content="Kure Monitor" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://kuremonitor.com/contact/" />
    <meta name="twitter:title" content="Contact Us | Kure Monitor" />
    <meta name="twitter:description" content="Get in touch with the Kure Monitor team for support, feature requests, or deployment questions." />
    <meta name="twitter:image" content="https://kuremonitor.com/images/og-image.png" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "Contact Kure Monitor",
        "description": "Contact page for Kure Monitor open-source Kubernetes AI observability.",
        "url": "https://kuremonitor.com/contact/",
        "mainEntity": {
          "@type": "Organization",
          "name": "Kure Monitor",
          "url": "https://kuremonitor.com",
          "email": "monitorkure@gmail.com",
          "sameAs": [
            "https://github.com/igor-koricanac/kure-monitor"
          ]
        }
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col justify-between">
    
    <!-- Navbar -->
    <header class="fixed w-full top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-slate-900 hover:text-blue-600 transition-colors">
          <span class="font-bold text-xl tracking-tight">Kure Monitor</span>
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <a href="/#features" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Features</a>
          <a href="/guides/air-gapped-k8s-local-llm-ollama/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Guides</a>
          <a href="/getting-started/introduction/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Docs</a>
          <a href="/demo/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Live Demo</a>
          <a href="/contact/" class="text-sm font-medium text-blue-600">Contact</a>
        </nav>
        <div class="flex items-center gap-4">
          <a href="https://github.com/igor-koricanac/kure-monitor" target="_blank" rel="noopener noreferrer" class="hidden sm:flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900">
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            Star
          </a>
          <a href="/getting-started/installation/" class="bg-blue-600 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-sm hover:bg-blue-700 hover:shadow transition-all">
            Get Started
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="pt-28 pb-16 px-4 max-w-5xl mx-auto w-full">
      <!-- Page Header -->
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase mb-4 border border-blue-200">
          Get in Touch
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">
          How can we help?
        </h1>
        <p class="text-base sm:text-lg text-slate-600">
          Have a question about Kure Monitor, deploying in production, reporting a bug, or contributing? We are here to help.
        </p>
      </div>

      <!-- Contact Channels Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <!-- Direct Email -->
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
          <div>
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center mb-4 border border-blue-100">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-2">Direct Email</h2>
            <p class="text-sm text-slate-600 mb-4 leading-relaxed">
              Best for private inquiries, enterprise security questionnaires, partnership discussions, or general feedback.
            </p>
          </div>
          <div>
            <a
              href="mailto:monitorkure@gmail.com"
              class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700 break-all"
            >
              monitorkure@gmail.com
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Documentation & Guides -->
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
          <div>
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4 border border-emerald-100">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-2">Documentation</h2>
            <p class="text-sm text-slate-600 mb-4 leading-relaxed">
              Step-by-step installation guides, configuration references, Helm values, and troubleshooting playbooks.
            </p>
          </div>
          <div>
            <a
              href="/reference/troubleshooting/"
              class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700"
            >
              Troubleshooting Docs
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Frequently Inquired Topics -->
      <div class="bg-white rounded-xl border border-slate-200 p-8 shadow-sm mb-12">
        <h2 class="text-xl font-bold text-slate-900 mb-6">Frequently Inquired Topics</h2>
        
        <div class="grid sm:grid-cols-2 gap-6 text-sm">
          <div class="border-l-2 border-blue-500 pl-4">
            <h3 class="font-semibold text-slate-900 mb-1">Air-Gapped & Offline Clusters</h3>
            <p class="text-slate-600">
              Need guidance setting up Kure Monitor with local models (Ollama, vLLM) in an air-gapped VPC? See our <a href="/guides/air-gapped-k8s-local-llm-ollama/" class="text-blue-600 hover:underline">Air-Gapped Guide</a> or email us for deployment advice.
            </p>
          </div>

          <div class="border-l-2 border-blue-500 pl-4">
            <h3 class="font-semibold text-slate-900 mb-1">Helm Chart & Custom Ingress</h3>
            <p class="text-slate-600">
              Running custom TLS certificates, cert-manager, Traefik, or Istio gateways? Check the <a href="/configuration/helm-values/" class="text-blue-600 hover:underline">Helm Values reference</a> or file an issue if a specific parameter is needed.
            </p>
          </div>

          <div class="border-l-2 border-blue-500 pl-4">
            <h3 class="font-semibold text-slate-900 mb-1">Security & Vulnerability Reports</h3>
            <p class="text-slate-600">
              To responsibly disclose a security vulnerability, please email <a href="mailto:monitorkure@gmail.com" class="text-blue-600 hover:underline">monitorkure@gmail.com</a> directly rather than opening a public issue.
            </p>
          </div>

          <div class="border-l-2 border-blue-500 pl-4">
            <h3 class="font-semibold text-slate-900 mb-1">Commercial & Enterprise Usage</h3>
            <p class="text-slate-600">
              Kure Monitor is 100% open-source under the Apache 2.0 license. You are free to run, fork, and integrate it inside commercial environments without licensing fees.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Action Card -->
      <div class="rounded-xl bg-slate-900 text-white p-8 flex flex-col sm:flex-row items-center justify-between gap-6 border border-slate-800">
        <div>
          <h2 class="text-lg font-bold mb-1">Looking to try Kure Monitor without installing?</h2>
          <p class="text-sm text-slate-400">Explore the interactive browser demo featuring live pod crashes, AI root cause analysis, and cluster topology.</p>
        </div>
        <div class="flex-shrink-0">
          <a
            href="/demo/"
            class="inline-flex items-center gap-2 bg-blue-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-blue-700 transition-colors"
          >
            Launch Demo
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="max-w-7xl mx-auto px-4 py-12 border-t border-slate-200 w-full flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500">
      <div>
        <strong class="text-slate-900">Kure Monitor</strong> — Apache 2.0 licensed, open source on GitHub.
      </div>
      <div class="flex gap-6">
        <a href="/" class="hover:text-blue-600">Home</a>
        <a href="https://github.com/igor-koricanac/kure-monitor" class="hover:text-blue-600">GitHub</a>
        <a href="https://artifacthub.io/packages/helm/kure-monitor/kure" class="hover:text-blue-600">Artifact Hub</a>
        <a href="/getting-started/introduction/" class="hover:text-blue-600">Documentation</a>
        <a href="/contact/" class="text-blue-600 font-medium">Contact</a>
      </div>
    </footer>

  </body>
</html>
