---
import '../styles/custom.css';
import '../tailwind.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kure Monitor | Open-Source Kubernetes AI Observability & Debugging</title>
    <meta name="description" content="Stop debugging Kubernetes failures manually. Kure detects pod crashes, uses local or cloud AI for instant fixes, and audits security misconfigurations." />
    
    <!-- OpenGraph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kuremonitor.com/" />
    <meta property="og:title" content="Kure Monitor | Open-Source Kubernetes AI Observability & Debugging" />
    <meta property="og:description" content="Stop debugging Kubernetes failures manually. Kure detects pod crashes, uses local or cloud AI for instant fixes, and audits security misconfigurations." />
    <meta property="og:image" content="https://kuremonitor.com/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kure Monitor - Open-Source AI Troubleshooting & Observability for Kubernetes" />
    <meta property="og:site_name" content="Kure Monitor" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://kuremonitor.com/" />
    <meta name="twitter:title" content="Kure Monitor | Open-Source Kubernetes AI Observability & Debugging" />
    <meta name="twitter:description" content="Stop debugging Kubernetes failures manually. Kure detects pod crashes, uses local or cloud AI for instant fixes, and audits security misconfigurations." />
    <meta name="twitter:image" content="https://kuremonitor.com/images/og-image.png" />
    <meta name="twitter:image:alt" content="Kure Monitor - Open-Source AI Troubleshooting & Observability for Kubernetes" />

    <!-- Reusing Starlight's favicon if present or default -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data (JSON-LD) for SoftwareApplication -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Kure Monitor",
        "headline": "Open-Source Kubernetes AI Troubleshooting & Observability",
        "operatingSystem": "Kubernetes, Linux",
        "applicationCategory": "DeveloperApplication",
        "softwareVersion": "2.4.5",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "license": "https://www.apache.org/licenses/LICENSE-2.0",
        "url": "https://kuremonitor.com",
        "downloadUrl": "https://artifacthub.io/packages/helm/kure-monitor/kure",
        "codeRepository": "https://github.com/igor-koricanac/kure-monitor",
        "description": "Kure Monitor is an open-source, air-gapped ready Kubernetes AI observability platform that detects pod crashes, image-pull errors, and scheduling issues in real time with private local LLMs or cloud AI.",
        "author": {
          "@type": "Organization",
          "name": "Kure Monitor",
          "url": "https://kuremonitor.com"
        }
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased overflow-x-hidden">
    
    <!-- Navbar -->
    <header class="fixed w-full top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="font-bold text-xl tracking-tight text-slate-900">Kure Monitor</span>
        </div>
        <nav class="hidden md:flex items-center gap-6">
          <a href="#features" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Features</a>
          <a href="/guides/air-gapped-k8s-local-llm-ollama/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Guides</a>
          <a href="/getting-started/introduction/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Docs</a>
          <a href="/demo/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Live Demo</a>
        </nav>
        <div class="flex items-center gap-4">
          <a href="https://github.com/igor-koricanac/kure-monitor" target="_blank" rel="noopener noreferrer" class="hidden sm:flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900">
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            Star
          </a>
          <a href="/getting-started/installation/" class="bg-blue-600 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-sm hover:bg-blue-700 hover:shadow transition-all">
            Get Started
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="pt-32 pb-16 px-4 max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-100 text-blue-700 text-sm font-medium mb-8 border border-blue-200">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded h-2 w-2 bg-blue-600"></span>
        </span>
        Real-time Kubernetes Observability
      </div>
      
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-slate-900 mb-6">
        Stop Debugging <br class="hidden sm:block" />
        <span class="text-blue-600">Kubernetes Manually</span>
      </h1>
      
      <p class="max-w-2xl mx-auto text-lg md:text-xl text-slate-600 mb-10">
        Kure detects pod crashes, image-pull errors, and scheduling issues in seconds, and uses AI to tell you exactly how to fix them. Open source and air-gapped ready.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a href="/getting-started/installation/" class="w-full sm:w-auto bg-blue-600 text-white font-semibold px-8 py-3.5 rounded-xl shadow-lg shadow-blue-200 hover:bg-blue-700 hover:-translate-y-0.5 transition-all">
          Install Kure Monitor
        </a>
        <a href="/demo/" class="w-full sm:w-auto bg-white text-slate-700 font-semibold px-8 py-3.5 rounded-xl border border-slate-200 shadow-sm hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center justify-center gap-2">
          View Interactive Demo
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
      
      <!-- Hero Image / Dashboard Mockup -->
      <div class="relative mx-auto w-full max-w-5xl rounded-lg overflow-hidden border border-slate-200 shadow-2xl shadow-slate-200/50 bg-slate-900">
        <!-- Mac-style window controls -->
        <div class="h-10 bg-slate-800 flex items-center px-4 border-b border-slate-700">
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded bg-rose-500"></div>
            <div class="w-3 h-3 rounded bg-yellow-500"></div>
            <div class="w-3 h-3 rounded bg-emerald-500"></div>
          </div>
          <div class="mx-auto text-xs font-medium text-slate-400">kure-dashboard.local</div>
        </div>
        <img 
          src="/images/demo.gif" 
          alt="Kure Monitor Kubernetes AI Observability Dashboard" 
          width="1280"
          height="720"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="w-full object-cover block" 
        />
      </div>
    </main>

    <!-- Trusted By / Tech Stack (Optional subtle bar) -->
    <section class="border-y border-slate-200 bg-white py-8">
      <div class="max-w-7xl mx-auto px-4 flex flex-wrap justify-center items-center gap-8 md:gap-16 text-slate-400 font-medium text-sm">
        <span class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg> Native Kubernetes</span>
        <span class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Fully Air-Gapped</span>
        <span class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg> Local LLM Support</span>
        <span class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14h-2V7h2v10z"/></svg> Grafana App</span>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Everything you need to observe and secure K8s</h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">Kure replaces fragmented monitoring tools with a unified, AI-native platform.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Feature 1 -->
          <div class="bg-white rounded-lg border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="h-48 overflow-hidden bg-slate-100 flex items-center justify-center p-4">
              <img 
                src="/images/ai-advice.gif" 
                alt="AI Kubernetes Failure Diagnosis" 
                width="600"
                height="340"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover rounded shadow-sm border border-slate-200" 
              />
            </div>
            <div class="p-6">
              <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">AI-Powered Diagnosis</h3>
              <p class="text-slate-600">Get instant, context-aware explanations and copy-paste fixes for failing pods using local or cloud LLMs.</p>
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="bg-white rounded-lg border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="h-48 overflow-hidden bg-slate-100 flex items-center justify-center p-4">
              <img 
                src="/images/security_scan_list.png" 
                alt="Kubernetes Security Misconfiguration Scanner" 
                width="600"
                height="340"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top rounded shadow-sm border border-slate-200" 
              />
            </div>
            <div class="p-6">
              <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Security Scanner</h3>
              <p class="text-slate-600">Continuously audit your cluster for 50+ misconfigurations, privileged containers, and RBAC issues.</p>
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="bg-white rounded-lg border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="h-48 overflow-hidden bg-slate-100 flex items-center justify-center p-4">
              <img 
                src="/images/pod_list.png" 
                alt="Real-Time Kubernetes Pod Monitoring" 
                width="600"
                height="340"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-left-top rounded shadow-sm border border-slate-200" 
              />
            </div>
            <div class="p-6">
              <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Real-Time Detection</h3>
              <p class="text-slate-600">Catch CrashLoopBackOff, OOMKilled, and Pending pods the moment they happen with Slack/Teams alerts.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Installation & Where Kure Fits -->
    <section class="py-24 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 grid lg:grid-cols-2 gap-16 items-center">
        <!-- Install Snippet -->
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-4">Install in two commands</h2>
          <p class="text-slate-600 mb-8">Kure installs cleanly via Helm and stores nothing outside your cluster. Lightweight and resource-friendly.</p>
          
          <div class="bg-slate-900 rounded-xl p-4 shadow-lg overflow-hidden border border-slate-800">
            <div class="flex items-center gap-2 mb-3 px-2">
              <div class="w-3 h-3 rounded bg-slate-700"></div>
              <div class="w-3 h-3 rounded bg-slate-700"></div>
              <div class="w-3 h-3 rounded bg-slate-700"></div>
            </div>
            <pre class="text-sm font-mono text-blue-300 overflow-x-auto p-2"><code><span class="text-emerald-400">helm</span> repo add kure-monitor https://kuremonitor.com/
<span class="text-emerald-400">helm</span> install kure-monitor kure-monitor/kure \
  --namespace kure-system --create-namespace \
  --set postgresql.password=<span class="text-yellow-300">"$(openssl rand -hex 24)"</span></code></pre>
          </div>
          <div class="mt-6 flex items-center gap-4">
            <a href="/getting-started/installation/" class="text-blue-600 font-medium hover:text-blue-700 flex items-center gap-1">
              Read full installation guide <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Where Kure Fits Table -->
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-4">Where Kure fits</h2>
          <p class="text-slate-600 mb-8">Kure focuses on <strong>failure diagnosis and security</strong>. It complements Prometheus and Grafana — it doesn't replace them.</p>
          
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                  <th class="px-6 py-4 font-semibold text-slate-900 w-1/2">Kure does</th>
                  <th class="px-6 py-4 font-semibold text-slate-900 w-1/2 border-l border-slate-200">Kure does not</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <tr>
                  <td class="px-6 py-4 text-slate-600">Real-time pod failure detection with AI fixes</td>
                  <td class="px-6 py-4 text-slate-600 border-l border-slate-200">Time-series metrics or alerting rules</td>
                </tr>
                <tr class="bg-slate-50/50">
                  <td class="px-6 py-4 text-slate-600">50+ security misconfiguration checks</td>
                  <td class="px-6 py-4 text-slate-600 border-l border-slate-200">Log aggregation or indexing</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-slate-600">Live topology graph + mirror pod testing</td>
                  <td class="px-6 py-4 text-slate-600 border-l border-slate-200">Multi-cluster monitoring</td>
                </tr>
                <tr class="bg-slate-50/50">
                  <td class="px-6 py-4 text-slate-600">Slack / Teams notifications on failure</td>
                  <td class="px-6 py-4 text-slate-600 border-l border-slate-200">Replace Prometheus or Datadog</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer Area (wrapping Starlight's footer if possible, or recreating minimally) -->
    <!-- Footer -->
    <footer class="max-w-7xl mx-auto px-4 py-12 border-t border-slate-200 mt-12 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500">
      <div>
        <strong class="text-slate-900">Kure Monitor</strong> — Apache 2.0 licensed, open source on GitHub.
      </div>
      <div class="flex gap-6">
        <a href="https://github.com/igor-koricanac/kure-monitor" class="hover:text-blue-600">GitHub</a>
        <a href="https://artifacthub.io/packages/helm/kure-monitor/kure" class="hover:text-blue-600">Artifact Hub</a>
        <a href="https://github.com/igor-koricanac/kure-monitor/blob/main/CHANGELOG.md" class="hover:text-blue-600">Changelog</a>
        <a href="mailto:monitorkure@gmail.com" class="hover:text-blue-600">Support</a>
      </div>
    </footer>

  </body>
</html>
