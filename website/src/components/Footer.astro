---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<footer class="kure-footer">
	<div class="kure-footer-inner">
		<div>
			<strong>Kure Monitor</strong>
			<span class="muted">— Apache 2.0 licensed, open source on GitHub.</span>
		</div>
		<div class="links">
			<a href="https://github.com/igor-koricanac/kure-monitor">GitHub</a>
			<a href="https://artifacthub.io/packages/helm/kure-monitor/kure">Artifact Hub</a>
			<a href="https://github.com/igor-koricanac/kure-monitor/blob/main/CHANGELOG.md">Changelog</a>
			<a href="https://github.com/igor-koricanac/kure-monitor/issues">Report an issue</a>
			<a href="mailto:monitorkure@gmail.com">Support</a>
		</div>
	</div>
</footer>

<style>
	.kure-footer {
		border-top: 1px solid var(--sl-color-hairline);
		margin-top: 2rem;
		padding: 1.5rem 0 0.5rem;
	}
	.kure-footer-inner {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		font-size: 0.85rem;
		color: var(--sl-color-text-accent);
	}
	.muted {
		color: var(--sl-color-gray-3);
	}
	.links {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
	}
	.links a {
		color: var(--sl-color-text);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--sl-color-accent);
		text-decoration: underline;
	}
	.github-support-widget {
		position: fixed;
		bottom: 2.5rem;
		right: 2.5rem;
		background: rgba(var(--sl-color-bg-nav), 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		padding: 1rem 1.25rem;
		text-decoration: none;
		color: var(--sl-color-text);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(255,255,255,0.05) inset;
		transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		z-index: 9999;
		overflow: hidden;
	}
	.github-support-widget::before {
		content: '';
		position: absolute;
		top: 0; left: -100%; width: 50%; height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
		transform: skewX(-20deg);
		transition: all 0.5s ease;
	}
	.github-support-widget:hover {
		transform: translateY(-4px) scale(1.02);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2), 0 0 0 1px var(--sl-color-accent) inset;
		border-color: transparent;
	}
	.github-support-widget:hover::before {
		left: 200%;
	}
	.github-support-content {
		display: flex;
		align-items: center;
		gap: 1rem;
		position: relative;
		z-index: 2;
	}
	.github-support-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		width: 42px;
		height: 42px;
		border-radius: 50%;
		box-shadow: 0 4px 10px rgba(0,0,0,0.2);
	}
	html[data-theme='light'] .github-support-icon {
		background: #24292e;
	}
	.github-support-text {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.github-support-title {
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}
	html[data-theme='light'] .github-support-title {
		color: var(--sl-color-black);
	}
	.github-support-desc {
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
	.github-support-star {
		margin-left: 0.75rem;
		background: linear-gradient(135deg, #fef08a, #eab308);
		padding: 0.4rem 0.8rem;
		border-radius: 2rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: #422006;
		display: flex;
		align-items: center;
		gap: 0.3rem;
		box-shadow: 0 2px 8px rgba(234, 179, 8, 0.3);
		transition: all 0.2s ease;
	}
	.github-support-widget:hover .github-support-star {
		transform: scale(1.05);
		box-shadow: 0 4px 12px rgba(234, 179, 8, 0.4);
	}
	.github-support-star svg {
		width: 14px;
		height: 14px;
	}
	@media (max-width: 768px) {
		.github-support-widget {
			display: none;
		}
	}
</style>

<a href="https://github.com/igor-koricanac/kure-monitor" target="_blank" class="github-support-widget">
  <div class="github-support-content">
    <div class="github-support-icon">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/>
      </svg>
    </div>
    <div class="github-support-text">
      <span class="github-support-title">Love Kure Monitor?</span>
      <span class="github-support-desc">Support us on GitHub</span>
    </div>
    <div class="github-support-star">
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      Star
    </div>
  </div>
</a>

<script>
  // Move the widget to the end of the body to escape Starlight's sidebar stacking contexts
  // which often block clicks in the bottom corners of the screen.
  const moveWidget = () => {
    const widget = document.querySelector('.github-support-widget');
    if (widget && widget.parentElement !== document.body) {
      document.body.appendChild(widget);
    }
  };
  
  // Run on load
  moveWidget();
  // Run on view transitions if enabled
  document.addEventListener('astro:page-load', moveWidget);
</script>
